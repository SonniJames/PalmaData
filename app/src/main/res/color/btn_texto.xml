<?xml version="1.0" encoding="utf-8"?>
<!-- Texto del botón: blanco activo, gris oscuro cuando está deshabilitado.
     Sin esto el texto blanco sobre el gris claro pierde contraste. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/btn_disabled_text" />
    <item android:color="@color/white" />
</selector>