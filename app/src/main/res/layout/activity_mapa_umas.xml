<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== FRANJA FERTILIZANTE ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/worker_bar_background"
        android:orientation="horizontal"
        android:elevation="3dp">

        <TextView
            android:id="@+id/tvFertilizanteSelector"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Seleccione fertilizante"
            android:textColor="@color/worker_not_set"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tvLimpiarFertilizante"
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:gravity="center"
            android:text="✕ Limpiar"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"
            android:paddingStart="12dp"
            android:paddingEnd="16dp"
            android:clickable="true"
            android:focusable="true"
            android:alpha="0.4" />

    </LinearLayout>

    <!-- ===== MAPA ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCentrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="Centrar en mi posición"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDescargarMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:src="@android:drawable/stat_sys_download"
            android:contentDescription="Descargar mapa para uso offline"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActualizarUmas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="160dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Actualizar UMAs"/>

    </FrameLayout>

    <!-- ===== PANEL UMA ===== -->
    <LinearLayout
        android:id="@+id/panelUma"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#E8F5E9"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvUmaNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fuera de las umas"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1B5E20" />

        <TextView
            android:id="@+id/tvUmaInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#2E7D32"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvUmaDosis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#33691E"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>