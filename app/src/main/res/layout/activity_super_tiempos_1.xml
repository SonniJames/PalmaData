<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/grid_background">

    <!-- ── Cabecera ─────────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:background="@color/header_background"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:elevation="6dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/logo_palma"
            android:scaleType="fitCenter"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="SUPERVISIÓN DE TIEMPOS"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/palma_green_dark"
            android:letterSpacing="0.05" />
    </LinearLayout>

    <!-- ── Cortador observado ───────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/worker_bar_background"
        android:gravity="center_vertical"
        android:padding="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cortador: "
            android:textSize="14sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/tvCortador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/worker_set" />

        <Button
            android:id="@+id/btnCambiarCortador"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Cambiar"
            android:textSize="12sp"
            android:backgroundTint="@color/btn_verde_medio"
            android:textColor="@color/btn_texto" />
    </LinearLayout>

    <!-- ── Estado y cronómetro ──────────────────────────────────────────────
         El cronómetro es la defensa principal contra el FIN olvidado: un
         evento de 14 minutos se ve de inmediato.                          -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:padding="14dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Sin evento activo"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/palma_green_dark" />

        <TextView
            android:id="@+id/tvCronometro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--:--"
            android:textSize="30sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="@color/palma_gold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── CORTE DE RACIMO ──────────────────────────────────────────
                 INICIO se marca al LLEGAR a la palma, no al primer corte:
                 el tiempo de evaluación es parte del ciclo.              -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CORTE DE RACIMO"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:padding="8dp">

                <Button
                    android:id="@+id/btnCorteInicio"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.1"
                    android:text="INICIO"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_verde_oscuro"
                    android:textColor="@color/btn_texto" />

                <Button
                    android:id="@+id/btnRacimosMenos"
                    android:layout_width="52dp"
                    android:layout_height="64dp"
                    android:layout_marginStart="6dp"
                    android:text="−"
                    android:textSize="24sp"
                    android:backgroundTint="@color/btn_gris"
                    android:textColor="@color/btn_texto" />

                <!-- El número ES el botón de sumar: es el que más se pulsa,
                     caminando y sin mirar, así que es el objetivo grande. -->
                <Button
                    android:id="@+id/btnRacimosMas"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:text="0"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_dorado"
                    android:textColor="@color/btn_texto_oscuro" />

                <Button
                    android:id="@+id/btnCorteFin"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.1"
                    android:layout_marginStart="6dp"
                    android:text="FIN"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_verde_medio"
                    android:textColor="@color/btn_texto" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Racimos: toque el número para sumar, − para corregir"
                android:textSize="11sp"
                android:textColor="@color/text_secondary"
                android:paddingTop="4dp"
                android:paddingBottom="14dp" />

            <!-- ── PARADA ─────────────────────────────────────────────────── -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PARADA"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_secondary"
                android:letterSpacing="0.08"
                android:paddingBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/white"
                android:padding="8dp"
                android:gravity="center_vertical">

                <Button
                    android:id="@+id/btnParadaInicio"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="INICIO"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_verde_oscuro"
                    android:textColor="@color/btn_texto" />

                <Spinner
                    android:id="@+id/spTipoParada"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.6"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp" />

                <Button
                    android:id="@+id/btnParadaFin"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="FIN"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:backgroundTint="@color/btn_verde_medio"
                    android:textColor="@color/btn_texto" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- ── Observaciones y descarte ─────────────────────────────── -->
            <EditText
                android:id="@+id/etObservaciones"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:hint="Observación del evento (opcional)"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="250"
                android:background="@color/white"
                android:padding="12dp"
                android:textSize="14sp"
                android:autofillHints="" />

            <Button
                android:id="@+id/btnCancelar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:text="DESCARTAR EVENTO EN CURSO"
                android:textSize="13sp"
                android:backgroundTint="@color/btn_dorado"
                android:textColor="@color/btn_texto_oscuro" />

            <TextView
                android:id="@+id/tvResumen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:text="Eventos registrados: 0"
                android:textSize="13sp"
                android:gravity="center"
                android:textColor="@color/text_secondary" />

        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/btnFinalizar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_margin="12dp"
        android:text="FINALIZAR JORNADA"
        android:textSize="15sp"
        android:textStyle="bold"
        android:backgroundTint="@color/palma_green_dark"
        android:textColor="@color/white" />

</LinearLayout>