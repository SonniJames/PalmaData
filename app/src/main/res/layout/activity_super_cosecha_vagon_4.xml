<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/grid_background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="72dp" android:orientation="horizontal" android:background="@color/header_background" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:elevation="6dp">
        <ImageView android:layout_width="52dp" android:layout_height="52dp" android:src="@drawable/logo_palma" android:scaleType="fitCenter" android:contentDescription="Logo" />
        <View android:layout_width="12dp" android:layout_height="match_parent" />
        <ImageView android:layout_width="0dp" android:layout_height="26dp" android:layout_weight="1" android:src="@drawable/texto_palma_data" android:scaleType="fitStart" android:adjustViewBounds="true" android:contentDescription="PalmaData" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="48dp" android:text="DATOS SUPERVISIÓN"
        android:gravity="center" android:textSize="16sp" android:textColor="@color/text_secondary"
        android:background="@color/white" android:elevation="2dp" />

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

            <!-- R. muestra: teclado numerico del sistema. El operario escribe el
                 valor y confirma con la tecla enter/OK; el teclado se baja solo. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. muestra" android:textSize="13sp" android:textColor="@color/text_primary" />
                <EditText android:id="@+id/etRacimosMuestra"
                    android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="2"
                    android:hint="0" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/palma_green_dark" android:textColorHint="@color/divider"
                    android:gravity="center" android:background="@color/white"
                    android:inputType="number" android:maxLength="6"
                    android:imeOptions="actionDone" android:maxLines="1" />
                <View android:layout_width="84dp" android:layout_height="1dp" />
            </LinearLayout>

            <!-- 1. R. verdes -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. verdes" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos1" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas1" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 2. R. sobremaduro -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. sobremaduro" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos2" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas2" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 3. R. podridos -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. podridos" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos3" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas3" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 4. Pendun. largo -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="Pendun. largo" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos4" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas4" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 5. R. mal formados -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. mal formados" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos5" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas5" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 6. R. enfermos -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. enfermos" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos6" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas6" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>
            <!-- 7. R. eupalamides -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="12dp" android:paddingEnd="12dp" android:background="@color/white" android:layout_marginBottom="2dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="3" android:text="R. eupalamides" android:textSize="13sp" android:textColor="@color/text_primary" />
                <TextView android:id="@+id/tvValor7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:text="0" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/palma_green_dark" android:gravity="center" />
                <Button android:id="@+id/btnMenos7" android:layout_width="40dp" android:layout_height="40dp" android:text="-" android:textSize="18sp" android:backgroundTint="@color/white" android:textColor="@color/text_primary" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginEnd="4dp"/>
                <Button android:id="@+id/btnMas7" android:layout_width="40dp" android:layout_height="40dp" android:text="+" android:textSize="18sp" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <Button android:id="@+id/btnAccion" android:layout_width="match_parent" android:layout_height="60dp"
        android:layout_margin="16dp" android:text="OBSERVACIONES" android:textSize="15sp"
        android:textStyle="bold" android:backgroundTint="@color/palma_green_dark" android:textColor="@color/white" />
</LinearLayout>