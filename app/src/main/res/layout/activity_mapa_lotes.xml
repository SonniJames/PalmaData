<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ===== MAPA ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnCentrar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="16dp"
            android:src="@android:drawable/ic_menu_mylocation"
            android:contentDescription="Centrar en mi posición"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnDescargarMapa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="88dp"
            android:src="@android:drawable/stat_sys_download"
            android:contentDescription="Descargar mapa para uso offline"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btnActualizarLotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="160dp"
            android:src="@android:drawable/ic_popup_sync"
            android:contentDescription="Actualizar lotes"/>

    </FrameLayout>

    <!-- ===== PANEL LOTE ===== -->
    <LinearLayout
        android:id="@+id/panelLote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#E3F2FD"
        android:elevation="4dp">

        <TextView
            android:id="@+id/tvLoteNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cargando lotes..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D47A1" />

        <TextView
            android:id="@+id/tvLoteInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textSize="14sp"
            android:textColor="#1565C0"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvLoteDetalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="15sp"
            android:textColor="#1976D2"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>